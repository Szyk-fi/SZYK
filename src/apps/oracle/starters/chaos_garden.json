{
  "name": "Chaos Garden",
  "kind": "generator",
  "description": "Self-playing Euclidean pings through a chaos-swept resonant filter; pads set the key.",
  "params": [
    {"id": "pulses", "name": "Pulses", "min": 1, "max": 16, "default": 7, "curve": "int", "page": 1},
    {"id": "div", "name": "Rate", "min": 0, "max": 3, "default": 2, "curve": "choice", "options": ["1/4", "1/8", "1/16", "1/32"], "page": 1},
    {"id": "pdecay", "name": "Ping Decay", "min": 0.03, "max": 1.5, "default": 0.25, "curve": "exp", "unit": "s", "page": 1},
    {"id": "chaos", "name": "Chaos", "min": 0, "max": 1, "default": 0.6, "page": 1},
    {"id": "spread", "name": "Filter Spread", "min": 0, "max": 4, "default": 2, "page": 2},
    {"id": "res", "name": "Resonance", "min": 0.3, "max": 0.97, "default": 0.85, "page": 2},
    {"id": "echo", "name": "Echo", "min": 0, "max": 1, "default": 0.4, "page": 2},
    {"id": "space", "name": "Space", "min": 0, "max": 1, "default": 0.4, "page": 2}
  ],
  "macros": [
    {"name": "Dense", "targets": [{"param": "pulses", "amount": 0.5}, {"param": "div", "amount": 0.3}]},
    {"name": "Wild", "targets": [{"param": "chaos", "amount": 0.4}, {"param": "spread", "amount": 0.5}]},
    {"name": "Ring", "targets": [{"param": "res", "amount": 0.3}, {"param": "pdecay", "amount": 0.4}]},
    {"name": "Far", "targets": [{"param": "echo", "amount": 0.5}, {"param": "space", "amount": 0.5}]}
  ],
  "global": [
    {"id": "clk", "type": "clock", "in": {"div": "div == 0 ? 1 : div == 1 ? 0.5 : div == 2 ? 0.25 : 0.125", "width": 0.3}},
    {"id": "hits", "type": "euclid", "in": {"clock": "clk", "steps": 16, "pulses": "pulses"}},
    {"id": "notes", "type": "seq", "values": [0, 3, 7, 10, 12, 15, 19, 24], "mode": "random", "in": {"clock": "hits"}},
    {"id": "penv", "type": "ad", "in": {"trig": "hits", "a": 0.001, "d": "pdecay"}},
    {"id": "tone", "type": "osc", "wave": "tri", "in": {"freq": "mtof(padnote - 12 + notes)"}},
    {"id": "wander", "type": "chaos", "map": "logistic", "in": {"rate": 3, "r": "chaos"}},
    {"id": "filt", "type": "filter", "mode": "bp", "in": {"in": "tone * penv", "cutoff": "clamp(900 * 2 ^ (wander * spread), 120, 9000)", "res": "res"}},
    {"id": "dl", "type": "delay", "max": 2, "in": {"in": "filt", "time": "60 / bpm * 0.375", "fb": 0.5, "damp": 0.4}},
    {"id": "dr", "type": "delay", "max": 2, "in": {"in": "filt", "time": "60 / bpm * 0.5", "fb": 0.45, "damp": 0.4}},
    {"id": "rev", "type": "reverb", "in": {"in": "filt + dl * echo * 0.5", "size": 0.85, "damp": 0.4}}
  ],
  "out": {"left": "filt * 1.5 + dl * echo + rev * space", "right": "filt * 1.5 + dr * echo + rev * space"}
}
