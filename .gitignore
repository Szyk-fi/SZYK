/target
.DS_Store

# Build / local
target/
.DS_Store
.claude/
.env
.env.*
*.log

# Local source archives / duplicate copies
portamax-source.zip
portamax-source/
portamax-github-source.zip

# Large local audio libraries: user-supplied, never committed (same
# reasoning as media/ and roms/ below). "Boom Bap Addict WAV" is a
# commercial sample pack that was accidentally committed in this
# repo's very first commit and has since been purged from history --
# gitignored now so it can't be re-added by accident.
samples/Drum Loops/
samples/Boom Bap Addict WAV/

# Media library (Vinyl/Reference/Studio/Memories test content): the
# user's own copyrighted music files (e.g. commercial FLAC albums),
# same "copyrighted, user-supplied, never committed" reasoning as
# roms/ below -- also several GB, which has no place in git history
# regardless of copyright.
media/

# Retro app: ROMs are copyrighted and must stay user-supplied, never
# committed (see retro.rs's module doc comment) -- same reasoning
# `presets/`'s per-user save data gets, just legally non-negotiable
# here. Save states/SRAM are per-user runtime data, not source, either.
roms/
saves/
