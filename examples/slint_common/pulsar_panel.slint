// Pulsar's right-hand panel: the real pattern bank -- slot strip A-H, the
// 8-lane x 16-step grid of the bar in view (velocity / chance / roll), the
// real playhead, per-lane hit flashes, and transport state. Sits beside
// the shared parameter rail in the 306px instrument column.
import { InstrumentPanel } from "instrument_widgets.slint";

export component PulsarPanel inherits InstrumentPanel {
    in property <color> paper;
    in property <string> genre;
    in property <float> bpm: 120;
    in property <int> slot;
    in property <int> playing-slot: -1;
    in property <[bool]> slot-filled;
    in property <bool> in-fill;
    in property <int> bar;
    in property <int> bars: 1;
    in property <string> pad-mode;
    in property <bool> record;
    in property <[string]> lane-names;
    in property <int> lane;
    in property <[bool]> lane-locked;
    in property <[bool]> lane-muted;
    in property <[float]> lane-flash;
    in property <[float]> cell-vel;
    in property <[int]> cell-mark;
    in property <int> playhead: -1;
    in property <int> cursor-lane: -1;
    in property <int> cursor-col: -1;
    in property <float> swing: 50;
    in property <float> peak;
    in property <string> status;
    // Rolls and locks get a second, warmer colour so they read apart
    // from plain hits without relying on brightness alone.
    property <color> roll-tint: #F2B544;

    caption: "BEAT / PATTERN BANK";

    VerticalLayout {
        spacing: 5px;
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text {
                text: root.genre;
                color: root.accent;
                font-family: "Space Grotesk";
                font-weight: 700;
                font-size: 14px;
                overflow: elide;
            }
            Text {
                text: round(root.bpm) + " BPM";
                color: root.ink.with-alpha(0.72);
                font-family: "JetBrains Mono";
                font-size: 12px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.record : Text {
                text: "● REC";
                color: #FF5A4D;
                font-family: "JetBrains Mono";
                font-weight: 700;
                font-size: 12px;
                vertical-alignment: center;
            }
            if root.in-fill : Rectangle {
                width: 32px;
                border-radius: 3px;
                background: root.roll-tint;
                Text {
                    width: 100%; height: 100%;
                    text: "FILL";
                    color: root.paper;
                    font-family: "JetBrains Mono";
                    font-weight: 700;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Slot strip: filled slots tinted, the playing one solid, the one
        // being edited outlined.
        HorizontalLayout {
            height: 15px;
            spacing: 3px;
            for filled[k] in root.slot-filled : Rectangle {
                property <bool> playing: k == root.playing-slot;
                property <bool> editing: k == root.slot;
                border-radius: 3px;
                background: self.playing ? root.accent : filled ? root.accent.with-alpha(0.25) : root.ink.with-alpha(0.05);
                border-width: self.editing ? 1.5px : 0px;
                border-color: root.ink;
                Text {
                    width: 100%; height: 100%;
                    text: ["A", "B", "C", "D", "E", "F", "G", "H"][k];
                    color: parent.playing ? root.paper : filled ? root.ink.with-alpha(0.9) : root.ink.with-alpha(0.35);
                    font-family: "JetBrains Mono";
                    font-weight: 700;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 8 lanes x 16 steps of the bar in view.
        Rectangle {
            height: 120px;
            property <length> label-w: 24px;
            property <length> cw: (self.width - self.label-w) / 16;
            property <length> rh: self.height / 8;
            for name[ln] in root.lane-names : Rectangle {
                property <bool> locked: ln < root.lane-locked.length && root.lane-locked[ln];
                property <bool> muted: ln < root.lane-muted.length && root.lane-muted[ln];
                property <float> flash: ln < root.lane-flash.length ? root.lane-flash[ln] : 0;
                x: 0px;
                y: ln * parent.rh;
                width: parent.label-w;
                height: parent.rh;
                opacity: self.muted ? 0.4 : 1.0;
                Text {
                    x: 0px;
                    height: 100%;
                    text: name;
                    color: parent.locked ? root.roll-tint : ln == root.lane ? root.accent : root.ink.with-alpha(0.72);
                    font-family: "JetBrains Mono";
                    font-weight: ln == root.lane ? 700 : 400;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: parent.width - 8px;
                    y: (parent.height - 4px) / 2;
                    width: 4px; height: 4px;
                    border-radius: 2px;
                    background: root.accent.with-alpha(parent.flash);
                }
            }
            for vel[c] in root.cell-vel : Rectangle {
                property <int> cell-lane: floor(c / 16);
                property <int> cell-col: mod(c, 16);
                property <int> mark: c < root.cell-mark.length ? root.cell-mark[c] : 0;
                property <bool> on: vel > 0;
                property <bool> head: self.cell-col == root.playhead;
                property <bool> muted: self.cell-lane < root.lane-muted.length && root.lane-muted[self.cell-lane];
                property <bool> cursor: self.cell-lane == root.cursor-lane && self.cell-col == root.cursor-col;
                x: parent.label-w + self.cell-col * parent.cw;
                y: self.cell-lane * parent.rh + 1px;
                width: parent.cw - 2px;
                height: parent.rh - 3px;
                border-radius: 2px;
                background: self.on
                    ? (self.head && !self.muted ? root.ink
                        : self.muted ? root.ink.with-alpha(0.16)
                        : self.mark == 2 ? root.roll-tint.with-alpha(0.45 + 0.55 * vel)
                        : root.accent.with-alpha((0.3 + 0.7 * vel) * (self.mark == 1 ? 0.55 : 1.0)))
                    : (self.head ? root.accent.with-alpha(0.22) : mod(self.cell-col, 4) == 0 ? root.ink.with-alpha(0.09) : root.ink.with-alpha(0.045));
                border-width: self.cursor ? 1px : 0px;
                border-color: root.ink;
            }
        }

        HorizontalLayout {
            height: 3px;
            spacing: 4px;
            padding-left: 24px;
            for b in root.bars : Rectangle {
                border-radius: 1.5px;
                background: b == root.bar ? root.accent : root.ink.with-alpha(0.1);
            }
        }

        HorizontalLayout {
            height: 12px;
            spacing: 8px;
            Text {
                text: root.pad-mode + "  ·  BAR " + (root.bar + 1) + "/" + root.bars + "  ·  SWING " + round(root.swing) + "%";
                color: root.ink.with-alpha(0.72);
                font-family: "JetBrains Mono";
                font-size: 12px;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: root.ink.with-alpha(0.1);
            Rectangle {
                x: 0px; y: 0px;
                width: parent.width * min(1.0, root.peak);
                height: 100%;
                border-radius: 2px;
                background: root.peak > 0.95 ? #FF5A4D : root.accent;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            Text {
                x: 0px; y: 0px;
                width: 100%;
                text: root.status;
                color: root.accent;
                font-family: "JetBrains Mono";
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
