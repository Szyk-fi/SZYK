// Plaits' play view (see src/apps/plaits_play.rs): the instrument at a
// glance, full width, no list. Engine and bank strip on top; the four
// dials the knobs turn; the 16 pads labelled for the current layer and
// coloured like the controller LEDs; and every expressive surface (stick,
// both depth sensors, the live output) on the right.
import { InstrumentPanel, ScopeSurface, SignalTrace } from "instrument_widgets.slint";

// A 270-degree dial drawn as two arcs. The value arc's end point is
// computed here because Slint paths can't take an angle directly.
component Dial inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> norm;
    in property <int> knob;
    in property <color> ink;
    in property <color> accent;
    in property <color> paper;
    property <float> n: max(0.002, min(1, root.norm));
    property <angle> a0: 135deg;
    property <angle> a1: 135deg + 270deg * self.n;
    VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: 56px;
            Path {
                width: 56px; height: 56px;
                viewbox-width: 56; viewbox-height: 56;
                stroke: root.ink.with-alpha(0.14);
                stroke-width: 5px;
                MoveTo { x: 28 + 22 * Math.cos(135deg); y: 28 + 22 * Math.sin(135deg); }
                ArcTo { radius-x: 22; radius-y: 22; x: 28 + 22 * Math.cos(45deg); y: 28 + 22 * Math.sin(45deg); large-arc: true; sweep: true; }
            }
            Path {
                width: 56px; height: 56px;
                viewbox-width: 56; viewbox-height: 56;
                stroke: root.knob > 0 ? root.accent : root.ink.with-alpha(0.45);
                stroke-width: 5px;
                MoveTo { x: 28 + 22 * Math.cos(root.a0); y: 28 + 22 * Math.sin(root.a0); }
                ArcTo { radius-x: 22; radius-y: 22; x: 28 + 22 * Math.cos(root.a1); y: 28 + 22 * Math.sin(root.a1); large-arc: root.n > 0.6667; sweep: true; }
            }
            if root.knob > 0 : Rectangle {
                x: parent.width / 2 - 8px; y: 20px;
                width: 16px; height: 16px; border-radius: 8px;
                background: root.accent;
                Text {
                    text: root.knob;
                    color: root.paper;
                    font-family: "JetBrains Mono"; font-weight: 700; font-size: 10px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.label;
            color: root.ink;
            font-family: "JetBrains Mono"; font-size: 9px; font-weight: 700;
            horizontal-alignment: center; overflow: elide;
        }
        Text {
            text: root.value;
            color: root.ink.with-alpha(0.6);
            font-family: "JetBrains Mono"; font-size: 9px;
            horizontal-alignment: center; overflow: elide;
        }
    }
}

export component PlaitsPlayPanel inherits InstrumentPanel {
    in property <color> paper;
    in property <[color]> bank-colors;
    in property <string> engine-name;
    in property <int> engine-index;
    in property <int> engine-bank;
    in property <string> layer;
    in property <[string]> dial-labels;
    in property <[string]> dial-values;
    in property <[float]> dial-norms;
    in property <[int]> dial-knobs;
    in property <[string]> pad-labels;
    in property <[int]> pad-state;
    in property <float> stick-x;
    in property <float> stick-y;
    in property <float> hand-l;
    in property <float> hand-r;
    in property <string> hand-l-target;
    in property <string> hand-r-target;
    in property <float> pitch;
    in property <string> key;
    in property <string> sounding;
    in property <int> voices;
    in property <bool> arp;
    in property <[float]> scope-mid-x;
    in property <[float]> scope-mid-y;
    in property <[float]> scope-length;
    in property <[float]> scope-angle;
    in property <string> status;

    property <color> bank-color: root.engine-bank < root.bank-colors.length ? root.bank-colors[root.engine-bank] : root.accent;

    caption: "MACRO OSCILLATOR / PLAY  ·  R1 MENU";

    VerticalLayout {
        spacing: 5px;

        // Engine, layer, key.
        HorizontalLayout {
            height: 22px;
            spacing: 8px;
            Text {
                text: (root.engine-index + 1) + "  " + root.engine-name;
                color: root.bank-color;
                font-family: "Space Grotesk"; font-weight: 700; font-size: 18px;
                vertical-alignment: center; overflow: elide;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 118px;
                border-radius: 3px;
                background: root.accent;
                Text {
                    text: "PADS · " + root.layer;
                    color: root.paper;
                    font-family: "JetBrains Mono"; font-weight: 700; font-size: 10px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            Text {
                text: root.key + (root.arp ? "  ARP" : "");
                width: 150px;
                color: root.ink;
                font-family: "JetBrains Mono"; font-size: 10px;
                horizontal-alignment: right; vertical-alignment: center; overflow: elide;
            }
        }

        // All 24 engines, the current bank picked out.
        HorizontalLayout {
            height: 5px;
            spacing: 2px;
            for e in 24 : Rectangle {
                border-radius: 1px;
                background: e == root.engine-index ? root.bank-color
                    : floor(e / 8) == root.engine-bank ? root.bank-color.with-alpha(0.3)
                    : root.ink.with-alpha(0.08);
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // Four dials, 2 x 2.
            VerticalLayout {
                width: 196px;
                spacing: 2px;
                for r in 2 : HorizontalLayout {
                    spacing: 4px;
                    for c in 2 : Dial {
                        property <int> i: r * 2 + c;
                        label: self.i < root.dial-labels.length ? root.dial-labels[self.i] : "";
                        value: self.i < root.dial-values.length ? root.dial-values[self.i] : "";
                        norm: self.i < root.dial-norms.length ? root.dial-norms[self.i] : 0;
                        knob: self.i < root.dial-knobs.length ? root.dial-knobs[self.i] : 0;
                        ink: root.ink; accent: root.accent; paper: root.paper;
                    }
                }
            }

            // The 16 pads in physical layout.
            VerticalLayout {
                width: 220px;
                spacing: 3px;
                for r in 4 : HorizontalLayout {
                    spacing: 3px;
                    for c in 4 : Rectangle {
                        property <int> i: r * 4 + c;
                        property <int> st: self.i < root.pad-state.length ? root.pad-state[self.i] : 0;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.ink.with-alpha(0.18);
                        background: self.st == 3 ? root.accent
                            : self.st == 1 ? root.accent.with-alpha(0.22)
                            : self.st == 2 ? #e0a030.with-alpha(0.25)
                            : root.ink.with-alpha(0.03);
                        Text {
                            x: 4px; width: parent.width - 8px;
                            text: parent.i < root.pad-labels.length ? root.pad-labels[parent.i] : "";
                            color: parent.st == 3 ? root.paper : root.ink;
                            font-family: "JetBrains Mono"; font-size: 9px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Expression surfaces.
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    height: 76px;
                    spacing: 8px;
                    // Stick: where expression has pushed Timbre/Morph.
                    Rectangle {
                        width: 72px;
                        border-width: 1px;
                        border-radius: 3px;
                        border-color: root.ink.with-alpha(0.2);
                        Rectangle { x: parent.width / 2; width: 1px; background: root.ink.with-alpha(0.1); }
                        Rectangle { y: parent.height / 2; height: 1px; background: root.ink.with-alpha(0.1); }
                        Rectangle {
                            width: 10px; height: 10px; border-radius: 5px;
                            x: parent.width / 2 + max(-0.5, min(0.5, root.stick-x)) * (parent.width - 12px) - 5px;
                            y: parent.height / 2 - max(-0.5, min(0.5, root.stick-y)) * (parent.height - 12px) - 5px;
                            background: root.accent;
                        }
                        Text {
                            x: 3px; y: 2px;
                            text: "STICK";
                            color: root.ink.with-alpha(0.5);
                            font-family: "JetBrains Mono"; font-size: 7px;
                        }
                    }
                    // Depth sensors, one meter per hand.
                    for h[i] in [root.hand-l, root.hand-r] : VerticalLayout {
                        width: 30px;
                        spacing: 2px;
                        Rectangle {
                            border-radius: 3px;
                            background: root.ink.with-alpha(0.08);
                            Rectangle {
                                y: parent.height * (1 - max(0, min(1, h)));
                                height: parent.height * max(0, min(1, h));
                                border-radius: 3px;
                                background: root.accent;
                            }
                        }
                        Text {
                            text: (i == 0 ? "L " : "R ") + (i == 0 ? root.hand-l-target : root.hand-r-target);
                            color: root.ink;
                            font-family: "JetBrains Mono"; font-size: 7px;
                            horizontal-alignment: center; overflow: elide;
                        }
                    }
                }
                ScopeSurface {
                    ink: root.ink; accent: root.accent;
                    SignalTrace {
                        width: 100%; height: 100%;
                        mid-x: root.scope-mid-x; mid-y: root.scope-mid-y;
                        lengths: root.scope-length; angles: root.scope-angle;
                        source-width: 160; source-height: 96;
                        trace: root.accent;
                        stroke-width: 1.4px;
                    }
                }
            }
        }

        // What's sounding, and the last thing that happened.
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text {
                text: (root.sounding == "" ? "—" : root.sounding)
                    + (abs(root.pitch) > 0.05 ? "   " + (root.pitch > 0 ? "+" : "") + round(root.pitch * 10) / 10 + " st" : "");
                color: root.accent;
                font-family: "JetBrains Mono"; font-weight: 700; font-size: 12px;
                vertical-alignment: center; overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.status != "" ? root.status : root.voices + (root.voices == 1 ? " voice" : " voices");
                color: root.ink.with-alpha(0.7);
                font-family: "JetBrains Mono"; font-size: 9px;
                horizontal-alignment: right; vertical-alignment: center; overflow: elide;
            }
        }
    }
}
