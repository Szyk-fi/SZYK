// Oracle's right-hand panel: the real compiled signal graph (laid out by
// `OracleApp::graph_layout`, each block glowing by its real output
// activity), the real output scope, the snapshot pads + morph, and the
// AI / voice-input status. Sits beside the shared parameter rail, the
// same 306px instrument column Tonestack and the other instruments use.
import { InstrumentPanel, ScopeSurface, SignalTrace, VectorSegment } from "instrument_widgets.slint";

export component OraclePanel inherits InstrumentPanel {
    in property <color> paper;
    in property <string> patch-name;
    in property <string> kind-label;
    // 0 graph, 1 snapshots, 2 thinking / transcribing, 3 explanation, 4 listening
    in property <int> mode;
    in property <[float]> node-x;
    in property <[float]> node-y;
    in property <[float]> node-w;
    in property <float> node-h: 12;
    in property <[string]> node-label;
    in property <[float]> node-activity;
    in property <[bool]> node-voice;
    in property <[float]> edge-mid-x;
    in property <[float]> edge-mid-y;
    in property <[float]> edge-length;
    in property <[float]> edge-angle;
    in property <int> forward-edges;
    in property <[float]> scope-mid-x;
    in property <[float]> scope-mid-y;
    in property <[float]> scope-length;
    in property <[float]> scope-angle;
    in property <[int]> snaps;
    in property <bool> morph-on;
    in property <float> morph;
    in property <string> info;
    in property <string> status;
    in property <bool> unstable;
    in property <string> explain;
    in property <string> thinking;
    in property <float> mic-level;
    // A second voice colour for shared/global blocks, so per-voice and
    // global parts of the graph read apart at a glance.
    property <color> global-tint: root.accent.mix(root.ink, 0.45);

    caption: root.mode == 1 ? "AI PATCH / SNAPSHOTS" : root.mode == 4 ? "AI PATCH / LISTENING" : "AI PATCH / SIGNAL GRAPH";

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text {
                text: root.patch-name;
                color: root.accent;
                font-family: "Space Grotesk";
                font-weight: 700;
                font-size: 14px;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.kind-label;
                color: root.ink.with-alpha(0.72);
                font-family: "JetBrains Mono";
                font-size: 12px;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
        }

        // Signal graph (mode 0).
        if root.mode == 0 : Rectangle {
            height: 128px;
            for i in root.edge-mid-x.length : VectorSegment {
                center-x: root.edge-mid-x[i] * 1px;
                center-y: root.edge-mid-y[i] * 1px;
                delta-x: root.edge-length[i] * cos(root.edge-angle[i] * 1deg);
                delta-y: root.edge-length[i] * sin(root.edge-angle[i] * 1deg);
                trace: i < root.forward-edges ? root.ink.with-alpha(0.28) : #E0B040.with-alpha(0.7);
                line-width: 1px;
            }
            for label[i] in root.node-label : Rectangle {
                property <float> act: i < root.node-activity.length ? sqrt(root.node-activity[i]) : 0;
                property <bool> voice: i < root.node-voice.length && root.node-voice[i];
                property <color> tint: self.voice ? root.accent : root.global-tint;
                x: root.node-x[i] * 1px;
                y: root.node-y[i] * 1px;
                width: root.node-w[i] * 1px;
                height: root.node-h * 1px;
                border-radius: 3px;
                background: root.paper.mix(self.tint, 1.0 - (0.12 + 0.88 * self.act));
                border-width: 1px;
                border-color: self.tint.with-alpha(0.6);
                Text {
                    x: 1px;
                    width: parent.width - 2px;
                    height: 100%;
                    text: label;
                    color: parent.act > 0.55 ? root.paper : root.ink.with-alpha(0.85);
                    font-family: "JetBrains Mono";
                    font-size: 12px;
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Snapshot pads + morph (mode 1).
        if root.mode == 1 : Rectangle {
            height: 128px;
            for state[i] in root.snaps : Rectangle {
                x: mod(i, 4) * (parent.width / 4);
                y: floor(i / 4) * (parent.height / 4);
                width: parent.width / 4 - 5px;
                height: parent.height / 4 - 5px;
                border-radius: 4px;
                background: state == 2 ? root.accent : state == 3 ? root.global-tint : state == 1 ? root.accent.with-alpha(0.35) : root.ink.with-alpha(0.045);
                border-width: 1px;
                border-color: root.accent.with-alpha(0.15);
                Text {
                    x: 5px; y: 3px;
                    text: state == 2 ? "A" : state == 3 ? "B" : "" + (i + 1);
                    color: state >= 2 ? root.paper : root.ink.with-alpha(0.72);
                    font-family: "JetBrains Mono";
                    font-size: 12px;
                }
            }
        }

        // The AI is designing, or a voice take is being transcribed (mode 2).
        if root.mode == 2 : Rectangle {
            height: 128px;
            property <float> t: animation-tick() / 1ms / 1000;
            for k in 6 : Rectangle {
                width: 8px; height: 8px;
                border-radius: 4px;
                x: parent.width / 2 + cos(parent.t * 160deg + k * 60deg) * 40px - 4px;
                y: parent.height / 2 + sin(parent.t * 160deg + k * 60deg) * 40px - 4px;
                background: root.accent.with-alpha(0.25 + k * 0.13);
            }
            Text {
                width: 100%; height: 100%;
                text: root.thinking;
                color: root.accent;
                font-family: "JetBrains Mono";
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // The AI's explanation (mode 3) takes the scope's space too.
        if root.mode == 3 : Rectangle {
            height: 168px;
            clip: true;
            Text {
                x: 0px; y: 0px;
                width: 100%;
                text: root.explain;
                color: root.ink.with-alpha(0.8);
                font-family: "JetBrains Mono";
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        // Listening (mode 4): live input level as a bar field.
        if root.mode == 4 : Rectangle {
            height: 128px;
            property <float> t: animation-tick() / 1ms / 1000;
            for k in 20 : Rectangle {
                property <bool> on: k < root.mic-level * 20;
                width: 7px;
                height: (8 + abs(sin(k * 50deg + parent.t * 300deg)) * (self.on ? 64 : 10)) * 1px;
                x: (parent.width - 20 * 13px) / 2 + k * 13px;
                y: (parent.height - 18px - self.height) / 2;
                border-radius: 3px;
                background: self.on ? root.accent : root.ink.with-alpha(0.1);
            }
            Text {
                y: parent.height - 14px;
                width: 100%;
                text: root.thinking + "   press again to stop";
                color: root.ink.with-alpha(0.72);
                font-family: "JetBrains Mono";
                font-size: 12px;
                horizontal-alignment: center;
            }
        }

        if root.mode == 1 && root.morph-on : Rectangle {
            height: 5px;
            border-radius: 2px;
            background: root.ink.with-alpha(0.12);
            Rectangle {
                x: 0px; y: 0px;
                width: parent.width * max(0, min(1, root.morph));
                height: 100%;
                border-radius: 2px;
                background: root.accent;
            }
        }

        if root.mode != 3 : ScopeSurface {
            height: 28px;
            ink: root.ink; accent: root.accent;
            SignalTrace {
                width: 100%; height: 100%;
                mid-x: root.scope-mid-x; mid-y: root.scope-mid-y;
                lengths: root.scope-length; angles: root.scope-angle;
                source-width: 290; source-height: 28;
                trace: root.accent;
                stroke-width: 1.4px;
            }
        }

        HorizontalLayout {
            height: 12px;
            spacing: 8px;
            Text {
                text: root.info;
                color: root.ink.with-alpha(0.72);
                font-family: "JetBrains Mono";
                font-size: 12px;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.unstable : Text {
                text: "NODE RESET";
                color: #FF5A4D;
                font-family: "JetBrains Mono";
                font-size: 12px;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            Text {
                x: 0px; y: 0px;
                width: 100%;
                text: root.status;
                color: root.accent;
                font-family: "JetBrains Mono";
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
