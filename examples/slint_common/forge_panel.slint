import { ParamListColumn } from "device_frame.slint";
import { VectorSegment } from "instrument_widgets.slint";
export component ForgePanel inherits Rectangle {
 in property <color> paper;in property <color> ink;in property <color> accent;
 in property <[string]> names;in property <[string]> values;in property <int> selected;in property <bool> more-above;in property <bool> more-below;
 in property <[float]> wave;in property <[float]> starts;in property <[float]> ends;in property <[float]> levels;in property <[string]> labels;
 in property <string> clip-name;in property <string> status;in property <string> mode;in property <string> source;
 in property <int> chunk;in property <bool> busy;in property <bool> recording;in property <float> duration;
 callback action(float,float);
 HorizontalLayout {spacing:18px;
  ParamListColumn {width:220px;row-names:root.names;row-values:root.values;selected-row:root.selected;more-above:root.more-above;more-below:root.more-below;paper:root.paper;ink:root.ink;accent:root.accent;instrument-style:true;}
  VerticalLayout {spacing:7px;padding-top:4px;padding-bottom:8px;
   HorizontalLayout {height:18px;Text {text:"SOUND → INSTRUMENT";color:root.accent;font-size:10px;font-weight:600;}Text {text:root.mode;color:root.ink;font-size:11px;horizontal-alignment:right;}}
   Rectangle {height:90px;border-radius:6px;background:root.ink.with-alpha(0.035);clip:true;
    Text {x:9px;y:7px;text:root.recording?"● CAPTURING / "+root.source:root.clip-name;color:root.ink;font-size:10px;overflow:elide;width:parent.width - 18px;}
    for i in root.starts.length : Rectangle {x:root.starts[i]*parent.width;y:26px;width:max(1px,(root.ends[i]-root.starts[i])*parent.width);height:parent.height - 43px;background:root.accent.with-alpha(i==root.chunk?0.2:mod(i,2)==0?0.04:0.09);border-width:i==root.chunk?1px:0px;border-color:root.accent.with-alpha(0.7);}
    for i in max(0,root.wave.length - 1) : VectorSegment {center-x:(i+0.5)*root.width/max(1,root.wave.length);center-y:53px-(root.wave[i]+root.wave[i+1])*17px;delta-x:root.width/1px/max(1,root.wave.length);delta-y:(root.wave[i]-root.wave[i+1])*34;trace:root.accent;line-width:1.3px;}
    for i in root.starts.length : Rectangle {x:root.starts[i]*parent.width;y:26px;width:1px;height:47px;background:root.accent.with-alpha(0.5);Text {x:3px;y:0;text:i+1;color:root.accent;font-size:7px;}}
    Text {x:9px;y:parent.height - 14px;text:root.busy?"ANALYZING / LOCAL DSP":root.starts.length+" CHUNKS · "+round(root.duration*100)/100+"s · 24 kHz";color:root.ink.with-alpha(0.55);font-size:8px;}
   }
   Rectangle {height:112px;
    for i in 16 : Rectangle {
     x:mod(i,4)*parent.width/4;y:floor(i/4)*28px;width:parent.width/4 - 4px;height:24px;
     background:root.levels[i]>0?root.accent.with-alpha(0.25+root.levels[i]*0.4):root.ink.with-alpha(0.045);
     border-radius:4px;border-width:1px;border-color:i==root.chunk?root.accent:root.accent.with-alpha(0.13);
     Text {x:5px;y:3px;text:i+1;color:root.accent;font-size:8px;}
     Text {x:19px;y:7px;width:parent.width - 22px;text:root.labels.length==0?"—":root.mode=="Chromatic"?"NOTE "+(i+1):root.mode=="Frankenstein"?"A·B·T":root.mode=="Mosaic"?"TONE "+(i+1):root.labels[mod(i,max(1,root.labels.length))];color:root.ink;font-size:8px;overflow:elide;}
     TouchArea {pointer-event(e)=>{if e.kind==PointerEventKind.down{root.action(i,1);}else if e.kind==PointerEventKind.up||e.kind==PointerEventKind.cancel{root.action(i,0);}}}
    }
   }
   HorizontalLayout {height:22px;spacing:5px;
    for i in 4 : Rectangle {horizontal-stretch:1;border-radius:3px;background:root.accent.with-alpha(0.1);Text{text:["IMPORT",root.recording?"STOP REC":"RECORD","REBUILD","SAVE"][i];color:root.accent;font-size:8px;horizontal-alignment:center;vertical-alignment:center;}TouchArea{enabled:!root.busy;clicked=>{root.action([-2,-1,-3,-4][i],0);}}}
   }
   Text {text:root.status;color:root.ink.with-alpha(0.7);font-size:10px;wrap:word-wrap;height:31px;}
  }
 }
}
