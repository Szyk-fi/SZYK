import { VectorSegment } from "instrument_widgets.slint";
export component SpectralTerrain inherits Rectangle {
 in property <[float]> history;in property <color> accent;in property <color> ink;in property <bool> frozen;
 clip:true;
 for i in 12*31 : VectorSegment {
  property <int> layer:floor(i/31);property <int> bin:mod(i,31);
  property <float> depth:self.layer/11.0;property <float> scale:0.38+self.depth*0.62;
  property <float> a:min(1,max(0,root.history[self.layer*32+self.bin])*8);property <float> b:min(1,max(0,root.history[self.layer*32+self.bin+1])*8);
  center-x:root.width/2+((self.bin+0.5)/31 - 0.5)*root.width*0.9*self.scale;
  center-y:root.height*(0.22+self.depth*0.62-(self.a+self.b)*0.15*self.scale);
  delta-x:root.width/1px*0.9*self.scale/31;delta-y:(self.a - self.b)*root.height/1px*0.3*self.scale;
  trace:root.accent.with-alpha(0.12+self.depth*0.78);line-width:self.layer==11?2px:1px;
 }
 for i in 11*8 : VectorSegment {
  property <int> layer:floor(i/8);property <int> bin:mod(i,8)*4;
  property <float> d:self.layer/11.0;property <float> next:(self.layer+1)/11.0;
  property <float> ax:0.5+(self.bin/31 - 0.5)*0.9*(0.38+self.d*0.62);property <float> bx:0.5+(self.bin/31 - 0.5)*0.9*(0.38+self.next*0.62);
  property <float> ay:0.22+self.d*0.62-min(1,max(0,root.history[self.layer*32+self.bin])*8)*0.3*(0.38+self.d*0.62);
  property <float> by:0.22+self.next*0.62-min(1,max(0,root.history[(self.layer+1)*32+self.bin])*8)*0.3*(0.38+self.next*0.62);
  center-x:(self.ax+self.bx)/2*root.width;center-y:(self.ay+self.by)/2*root.height;delta-x:(self.bx - self.ax)*root.width/1px;delta-y:(self.by - self.ay)*root.height/1px;trace:root.accent.with-alpha(0.15);line-width:1px;
 }
 Text {x:12px;y:9px;text:root.frozen?"SPECTRAL TERRAIN / HOLD":"SPECTRAL TERRAIN / LIVE";color:root.accent;font-size:9px;}
 Text {x:12px;y:parent.height - 20px;text:"LOW → HIGH      DEPTH / RECENT HISTORY";color:root.ink.with-alpha(0.5);font-size:8px;}
}
export component SwarmNetwork inherits Rectangle {
 in property <[float]> levels;in property <[float]> phases;in property <[float]> notes;
 in property <color> accent;in property <color> ink;in property <int> count;in property <float> cohesion;
 callback pad(int,bool);
 clip:true;
 for ring in 3 : Rectangle {x:parent.width/2 - self.width/2;y:parent.height/2 - self.height/2;width:parent.width*(0.35+ring*0.25);height:parent.height*(0.32+ring*0.23);border-radius:self.width/2;border-width:1px;border-color:root.accent.with-alpha(0.07);}
 for i in 48 : VectorSegment {
  property <int> a:mod(i,16);property <int> b:mod(self.a+1+floor(i/16)*3,max(1,root.count));
  property <float> at:self.a*137.5+root.phases[self.a]*65;property <float> bt:self.b*137.5+root.phases[self.b]*65;
  property <float> ar:0.19+(1 - root.cohesion)*0.19+mod(root.notes[self.a],12)*0.008;property <float> br:0.19+(1 - root.cohesion)*0.19+mod(root.notes[self.b],12)*0.008;
  property <float> ax:0.5+cos(self.at*1deg)*self.ar;property <float> ay:0.51+sin(self.at*1deg)*self.ar*0.85;
  property <float> bx:0.5+cos(self.bt*1deg)*self.br;property <float> by:0.51+sin(self.bt*1deg)*self.br*0.85;
  visible:self.a<root.count;center-x:(self.ax+self.bx)/2*root.width;center-y:(self.ay+self.by)/2*root.height;delta-x:(self.bx - self.ax)*root.width/1px;delta-y:(self.by - self.ay)*root.height/1px;
  trace:root.accent.with-alpha(0.045+min(root.levels[self.a],root.levels[self.b])*0.45);line-width:1px;
 }
 for i in 16 : Rectangle {
  visible:i<root.count;property <float> angle:i*137.5+root.phases[i]*65;property <float> radius:0.19+(1 - root.cohesion)*0.19+mod(root.notes[i],12)*0.008;
  x:parent.width*(0.5+cos(self.angle*1deg)*self.radius)-14px;y:parent.height*(0.51+sin(self.angle*1deg)*self.radius*0.85)-14px;width:28px;height:28px;
  Rectangle {width:28px;height:28px;border-radius:14px;background:root.accent.with-alpha(root.levels[i]*0.08);}
  Rectangle {x:8px;y:8px;width:12px;height:12px;border-radius:6px;border-width:1px;border-color:root.accent.with-alpha(0.3+root.levels[i]*0.7);background:root.accent.with-alpha(root.levels[i]*0.7);}
  Text {x:22px;y:2px;text:root.levels[i]>0.01?["C","C♯","D","E♭","E","F","F♯","G","A♭","A","B♭","B"][mod(round(root.notes[i]),12)]+(floor(root.notes[i]/12)-1):"";color:root.ink.with-alpha(0.3+root.levels[i]*0.5);font-size:8px;}
  TouchArea {pointer-event(e)=>{if e.kind==PointerEventKind.down {root.pad(i,true);}else if e.kind==PointerEventKind.up || e.kind==PointerEventKind.cancel {root.pad(i,false);}}}
 }
 Text {x:12px;y:9px;text:"VOICE NETWORK / "+root.count+" NODES";color:root.accent;font-size:9px;}
 Text {x:12px;y:parent.height - 20px;text:"PITCH · PHASE · ENVELOPE / TOUCH TO PLAY";color:root.ink.with-alpha(0.5);font-size:8px;}
}
