// 800 x 480 landscape panel. Small desktop windows show the panel alone.
// Pad indices, F-key callbacks and MIDI encoder compatibility are preserved.
import { ComboBox } from "std-widgets.slint";

export struct BarSegment {
    label: string,
    active: bool,
}

// A real, windowed + scrolled param list -- the same "name | value"
// list every live-prototype screen shows (each real app's own
// `ParamList`, via `windowed_rows`-style pub(crate) accessors),
// factored out here so each screen doesn't re-describe the same ~60
// lines of Slint. See slint_plaits_live.rs for the pattern this was
// pulled from.
export component ParamListColumn inherits Rectangle {
    in property <[string]> row-names: [];
    in property <[string]> row-values: [];
    in property <[bool]> row-is-group: [];
    // Optional real meter fraction per row, 0..1 -- a negative value
    // (the default for every index past what a caller sets) means "no
    // bar for this row" (a group row, or any screen that doesn't have
    // a meaningful level). Slint arrays have no Option type, so a
    // sentinel is the simplest way to make this genuinely optional
    // without a second parallel bool array.
    in property <[float]> row-levels: [];
    in property <int> selected-row: 0;
    in property <bool> more-above: false;
    in property <bool> more-below: false;
    in property <color> accent: #5CF07A;
    // The unselected-row/secondary text color -- white by default
    // (every screen's old look), but overridable per-app (see
    // `LiveHomeScreen`'s `live-ink`) so a light-bodied app (Clouds,
    // Turing Machine, Tonestack, Plaits, ...) gets dark text instead
    // of white-on-white.
    in property <color> ink: #ffffff;
    // The home/launcher list only -- larger text, per the real
    // device's main menu being read from across a room, at the cost
    // of fewer rows fitting on screen at once (the caller windows its
    // data to fewer rows accordingly). Every other screen (an app's
    // own narrow side list) stays at the normal size.
    in property <bool> big-text: false;
    in property <bool> instrument-style: false;
    callback row-picked(int);
    callback row-adjusted(int, int);

    in property <color> paper: #0b100c;
    VerticalLayout {
        alignment: start;
        spacing: 1px;
        HorizontalLayout {
            // The old "SELECT / EDIT / R1 OPEN" line lived here; the shell's
            // hint line above the F bar says it now (App::hint).
            height: root.more-above ? 18px : 0px;
            Text {
                text: root.more-above ? "↑" : "";
                color: root.accent; font-size: 12px; horizontal-alignment: right;
                TouchArea { clicked => { root.row-picked(-1); } }
            }
        }
        for name[i] in root.row-names : row := Rectangle {
            property <bool> selected: i == root.selected-row;
            property <bool> group: i < root.row-is-group.length && root.row-is-group[i];
            property <float> level: i < root.row-levels.length ? root.row-levels[i] : -1;
            height: 44px;
            border-radius: 3px;
            background: self.selected ? root.accent : self.group ? root.ink.with-alpha(0.035) : transparent;
            VerticalLayout {
                padding-left: row.group || root.big-text ? 8px : 14px;
                padding-right: 95px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 1px;
                Text {
                    text: name; height: 19px;
                    color: row.selected ? root.paper : root.ink.with-alpha(0.86);
                    font-family: "Space Grotesk";
                    font-size: root.big-text ? 18px : 15px;
                    font-weight: row.selected || row.group ? 600 : 400;
                    overflow: elide; min-width: 0px;
                }
                Text {
                    text: i < root.row-values.length ? root.row-values[i] : "";
                    height: 17px;
                    color: row.selected ? root.paper : root.ink.with-alpha(0.72);
                    font-family: "JetBrains Mono"; font-size: 13px;
                    overflow: elide; min-width: 0px;
                }
            }
            TouchArea {
                width: parent.width - 92px;
                property <length> last-y; property <bool> dragged: false;
                pointer-event(e) => { if e.kind == PointerEventKind.down { self.last-y = self.mouse-y; self.dragged = false; } }
                moved => { if self.pressed && !row.group && Math.abs(self.last-y - self.mouse-y) >= 4px {
                    self.dragged = true; root.row-adjusted(i, round((self.last-y - self.mouse-y) / 4px)); self.last-y = self.mouse-y;
                } }
                clicked => { if !self.dragged { root.row-picked(i); } }
            }
            for delta in [-1, 1] : Rectangle {
                x: parent.width - (delta < 0 ? 90px : 44px); width: 44px; height: 44px;
                visible: !row.group;
                Text { text: delta < 0 ? "−" : "+"; color: row.selected ? root.paper : root.ink; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.row-adjusted(i, delta); } }
            }
            if row.level >= 0 : Rectangle {
                x: 8px; y: parent.height - 2px;
                width: (parent.width - 16px) * max(0, min(1, row.level)); height: 2px;
                background: row.selected ? root.paper.with-alpha(0.45) : root.accent;
            }
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            height: root.big-text ? 18px : 24px;
            text: root.big-text ? (root.more-below ? "↓ MORE APPS" : "R1 OPEN") :
                (root.selected-row < root.row-values.length && root.row-values[root.selected-row] != "" ? root.row-values[root.selected-row] : "R1 SELECT  ·  ◀ ▶ ADJUST") + (root.more-below ? "  ↓" : "");
            color: root.ink.with-alpha(0.72);
            font-family: "JetBrains Mono";
            font-size: root.big-text ? 10px : 9px;
            wrap: word-wrap; overflow: elide;
            vertical-alignment: center;
            TouchArea { enabled: root.more-below; clicked => { root.row-picked(root.row-names.length); } }
        }
    }

}

// One step on press; repeat after 250 ms, then every 100 ms until release.
component DirectionalButton inherits Rectangle {
    in property <string> symbol;
    callback activated(int);
    property <bool> repeating: false;
    // Repeats counted since the press; first lands at 250 ms, then every
    // 100 ms, so 6 is 0.75 s and 16 is 1.75 s -- same schedule as
    // controller_map::hold_multiplier (x1, x5, x20).
    property <int> ticks: 0;
    width: 38px; height: 38px; border-radius: 4px;
    background: touch.pressed ? #4b5055 : #222528;
    Text {
        text: root.symbol; color: #858b90; font-size: 18px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.repeating = false;
                root.ticks = 0;
                root.activated(1);
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.repeating = false;
            }
        }
    }
    Timer {
        interval: root.repeating ? 100ms : 250ms;
        running: touch.pressed;
        triggered => {
            if touch.pressed {
                root.repeating = true;
                root.ticks += 1;
                root.activated(root.ticks < 6 ? 1 : root.ticks < 16 ? 5 : 20);
            }
        }
    }
}

export component DeviceFrame inherits Window {
    // Steps the current D-pad press is worth (held ◄/► ramps up).
    in-out property <int> dpad-step: 1;
    preferred-width: 1460px;
    preferred-height: 656px;
    min-width: 800px;
    min-height: 480px;
    in property <bool> panel-only: root.width < 1460px || root.height < 656px;
    property <length> enclosure-x: (root.width - 1420px) / 2;
    property <length> enclosure-y: (root.height - 560px) / 2;
    out property <length> display-width: root.panel-only ? min(root.width, root.height * 5 / 3) : 800px;
    out property <length> display-height: root.display-width * 3 / 5;
    in property <bool> boot-screen: false;
    out property <length> body-height: root.boot-screen ? root.display-height : root.hide-chrome ? root.display-height - 48px : root.display-height - 112px;
    background: #252628;
    title: "ROVE — Portable console";
    in property <string> app-name: "APP";
    in property <string> breadcrumb: "";
    // Full-screen apps hide title/hints; touch navigation remains available.
    in property <bool> hide-chrome: false;
    in property <color> accent: #5CF07A;
    in property <color> screen-bg: #0B100C;
    in property <color> screen-ink: #ffffff;
    in property <string> hint-line: "";
    in property <[bool]> function-enabled: [true, true, true, true];
    in-out property <[string]> key-target-options: [];
    in-out property <int> key-target-index: 0;
    callback key-target-selected(int);
    in property <bool> key-target-current-available: false;
    callback midi-arm-toggled();
    in property <[BarSegment]> bar: [
        { label: "F1  SETTINGS", active: false },
        { label: "F2  HOME", active: false },
        { label: "F3  STOP", active: false },
        { label: "F4  MIXER", active: false },
    ];
    in property <[color]> pad-colors: [
        #232323, #232323, #232323, #232323,
        #232323, #232323, #232323, #232323,
        #232323, #232323, #232323, #232323,
        #232323, #232323, #232323, #232323,
    ];
    // Compatibility API for existing examples and MIDI encoder state.
    // Encoders have no visible representation on this enclosure.
    callback knob1-dragged(float);
    callback knob2-dragged(float);
    in-out property <angle> knob1-angle: 0deg;
    in-out property <angle> knob2-angle: 0deg;
    callback knob1-pressed();
    callback knob2-pressed();
    callback pad-pressed(int, bool);
    callback f-pressed(int);
    // Directions: up, right, down, left, select. Shoulders: L1, R1.
    callback navigation-pressed(int);
    callback shoulder-pressed(int);
    in-out property <float> stick-x: 0;
    in-out property <float> stick-y: 0;
    // Play surface (see App::play_surface): held shoulders, stick clicks
    // counted separately from D-pad select, and the two depth sensors'
    // hand distance (0 = no hand, 1 = closest).
    in-out property <bool> l1-held: false;
    in-out property <bool> r1-held: false;
    in-out property <int> stick-clicks: 0;
    // When true, a stick click is only counted (the app plays it);
    // otherwise it also acts as select, as before.
    in property <bool> stick-owned: false;
    in-out property <float> hand-l: 0;
    in-out property <float> hand-r: 0;

    if root.key-target-options.length > 1 : Rectangle {
        visible: !root.panel-only;
        x: root.enclosure-x + 188px; y: root.enclosure-y + 564px; width: 800px; height: 34px;
        background: transparent;
        HorizontalLayout {
            spacing: 10px;
            Text { text: "MIDI ARM"; color: root.key-target-index > 1 ? #f17e68 : #b7d6c5; font-size: 11px; vertical-alignment: center; }
            ComboBox {
                width: 200px;
                model: root.key-target-options;
                current-index <=> root.key-target-index;
                selected(_) => { root.key-target-selected(self.current-index); }
            }
            Rectangle {
                width: 74px; border-radius: 4px;
                property <bool> armed: root.key-target-index > 1;
                property <bool> available: self.armed || root.key-target-current-available;
                opacity: self.available ? 1 : 0.35;
                background: self.armed ? #67362e : #17231d;
                Text { text: parent.armed ? "DISARM" : "ARM"; color: #f2eee5; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { enabled: parent.available; clicked => { root.midi-arm-toggled(); } }
            }
            Text {
                text: (root.key-target-index > 1 ? "ARMED   ·   CONTROLS: " : root.key-target-index == 1 ? "DISARMED   ·   CONTROLS: " : "AUTO   ·   CONTROLS: ") + root.app-name;
                color: #b7d6c5; font-size: 11px; vertical-alignment: center;
                overflow: elide; horizontal-stretch: 1;
            }
        }
    }

    // Shoulder buttons project above the rectangular aluminium rim.
    for side in [0, 1] : Rectangle {
        visible: !root.panel-only;
        x: root.enclosure-x + (side == 0 ? 25px : 1231px); y: root.enclosure-y - 12.5px;
        width: 164px; height: 23px;
        border-radius: 6px;
        background: shoulder-touch.pressed ? #44474a : #181a1c;
        border-width: 1px; border-color: #505357;
        Text {
            x: 0px; y: 0px; width: 100%; height: 12px;
            text: side == 0 ? "L1" : "R1";
            color: #c5c7ca; font-size: 12px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
            letter-spacing: 1px;
        }
        shoulder-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { if side == 0 { root.l1-held = true; } else { root.r1-held = true; } }
                if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { if side == 0 { root.l1-held = false; } else { root.r1-held = false; } }
            }
            clicked => { root.shoulder-pressed(side); }
        }
    }
    Rectangle {
        x: root.panel-only ? 0px : root.enclosure-x;
        y: root.panel-only ? 0px : root.enclosure-y;
        width: root.panel-only ? root.width : 1420px;
        height: root.panel-only ? root.height : 560px;
        border-radius: 34px; background: #070809;
        border-width: 2px; border-color: #4b4d50;
        Rectangle {
            x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
            border-radius: 30px; border-width: 1px; border-color: #24272a;
            background: #101113;
        }
        // Camera: a small lens above pad 1 on the right-hand deck.
        Rectangle {
            visible: !root.panel-only;
            x: 1057px; y: 34px; width: 33px; height: 33px;
            border-radius: 16.5px; background: #050606;
            border-width: 2px; border-color: #3a3f44;
            Rectangle { x: 7.5px; y: 7.5px; width: 12px; height: 12px; border-radius: 6px; background: #11161c; border-width: 1px; border-color: #2a3139; }
            Rectangle { x: 9px; y: 9px; width: 4.5px; height: 4.5px; border-radius: 3px; background: #4a5c70; }
        }
        // Two depth (time-of-flight) sensors, one per hand. In the sim:
        // press a lens and drag up to bring the hand closer, down to pull
        // it away; let go and the hand leaves.
        for side in [0, 1] : lens := Rectangle {
            property <float> value: side == 0 ? root.hand-l : root.hand-r;
            visible: !root.panel-only;
            x: side == 0 ? 60px : 1300px; y: 16px;
            width: 72px; height: 30px;
            Rectangle {
                x: 2px; y: 7px; width: 16px; height: 16px; border-radius: 8px;
                background: #050606; border-width: 2px;
                border-color: lens.value > 0 ? #5cf07a.with-alpha(0.35 + 0.65 * lens.value) : #2c3034;
                Rectangle { x: 4px; y: 4px; width: 4px; height: 4px; border-radius: 2px; background: #3c4248; }
            }
            Rectangle {
                x: 24px; y: 13px; width: 44px; height: 4px; border-radius: 2px; background: #1e2124;
                Rectangle { x: 0px; y: 0px; width: 44px * lens.value; height: 100%; border-radius: 2px; background: #5cf07a; }
            }
            Text {
                x: 24px; y: 19px; text: side == 0 ? "HAND L" : "HAND R";
                color: #6c7075; font-family: "JetBrains Mono"; font-size: 12px;
            }
            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { if side == 0 { root.hand-l = 0.5; } else { root.hand-r = 0.5; } }
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { if side == 0 { root.hand-l = 0; } else { root.hand-r = 0; } }
                }
                moved => {
                    if self.pressed {
                        if side == 0 { root.hand-l = max(0.02, min(1, 0.5 + (self.pressed-y - self.mouse-y) / 80px)); }
                        else { root.hand-r = max(0.02, min(1, 0.5 + (self.pressed-y - self.mouse-y) / 80px)); }
                    }
                }
            }
        }
        // Native 5:3 panel; raster apps contain-fit their own coordinate canvas.
        Rectangle {
            x: root.panel-only ? (parent.width - root.display-width) / 2 : 180px;
            y: root.panel-only ? (parent.height - root.display-height) / 2 : 36px;
            width: root.display-width + (root.panel-only ? 0px : 16px);
            height: root.display-height + (root.panel-only ? 0px : 16px);
            border-radius: 10px; background: #000;
            border-width: 1px; border-color: #34373a;
            Rectangle {
                x: root.panel-only ? 0px : 8px; y: root.panel-only ? 0px : 8px;
                width: root.display-width; height: root.display-height;
                background: root.screen-bg; border-radius: 4px; clip: true;
                VerticalLayout {
                    // Title row
                    HorizontalLayout {
                        height: root.hide-chrome ? 0px : 40px;
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 12px;
                        Text {
                            text: root.app-name;
                            font-family: "Space Grotesk";
                            font-weight: 700;
                            font-size: 27px;
                            letter-spacing: 0.4px;
                            color: root.accent;
                            vertical-alignment: bottom;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.breadcrumb;
                            font-family: "JetBrains Mono";
                            font-size: 12px;
                            letter-spacing: 0.6px;
                            color: root.screen-ink.with-alpha(0.72);
                            vertical-alignment: bottom;
                        }
                    }

                    // Native layout space; chrome remains pinned below the clipped body.
                    Rectangle {
                        height: root.body-height;
                        clip: true;
                        @children
                    }

                    // The one line every screen spends on what the controls
                    // do right now (App::hint).
                    Rectangle {
                        height: root.hide-chrome ? 0px : 24px;
                        clip: true;
                        Text {
                            x: 18px; width: parent.width - 36px;
                            text: root.hint-line;
                            font-size: 11px;
                            color: root.screen-ink.with-alpha(0.62);
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    // On-screen bottom bar -- sized for real
                    // legibility on a ~245 PPI 3" panel, not the
                    // desktop mockup's original proportions. See
                    // slint_launcher_poc.rs's doc comment for the
                    // PPI math.
                    Rectangle {
                        height: root.boot-screen ? 0px : 48px;
                        clip: true;
                        Rectangle {
                            y: 0px; height: 1px;
                            background: root.screen-ink.with-alpha(0.14);
                        }
                        HorizontalLayout {
                            y: 1px;
                            height: 47px;
                            for seg[i] in root.bar: Rectangle {
                                opacity: root.function-enabled[i] ? 1 : 0.35;
                                background: root.screen-ink.with-alpha(0.035);
                                border-width: 1px; border-color: root.screen-ink.with-alpha(0.1);
                                TouchArea { enabled: root.function-enabled[i]; clicked => { root.f-pressed(i); } }
                                Text { width: 100%; height: 100%;
                                horizontal-stretch: 1;
                                text: seg.label;
                                font-family: "JetBrains Mono";
                                font-size: 16px;
                                letter-spacing: 0.4px;
                                font-weight: seg.active ? 700 : 400;
                                color: seg.active ? root.accent : root.accent.with-alpha(0.72);
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
        // Recessed cross D-pad, with four separately held directions.
        Rectangle {
            visible: !root.panel-only;
            x: 24px; y: 88px; width: 144px; height: 144px;
            border-radius: 72px; background: #090a0b;
            border-width: 1px; border-color: #222529;
            Rectangle { x: 49px; y: 12px; width: 46px; height: 120px; background: #222528; border-radius: 5px; }
            Rectangle { x: 12px; y: 49px; width: 120px; height: 46px; background: #222528; border-radius: 5px; }
            for direction in [0, 1, 2, 3] : DirectionalButton {
                x: direction == 1 ? 94px : (direction == 3 ? 12px : 50px);
                y: direction == 0 ? 12px : (direction == 2 ? 94px : 50px);
                symbol: direction == 0 ? "▴" : (direction == 1 ? "▸" : (direction == 2 ? "▾" : "◂"));
                activated(step) => { root.dpad-step = step; root.navigation-pressed(direction); }
            }
            Rectangle {
                x: 53px; y: 53px; width: 38px; height: 38px;
                border-radius: 19px; background: center-touch.pressed ? #3b4045 : #1b1e21;
                Rectangle { x: 15px; y: 15px; width: 8px; height: 8px; border-radius: 4px; background: #44494e; }
                // SELECT: tap = select (expand, run, next dial); hold
                // half a second = reset (the gamepad's Reset button).
                center-touch := TouchArea {
                    property <bool> held-fired: false;
                    pointer-event(event) => { if event.kind == PointerEventKind.down { self.held-fired = false; } }
                    clicked => { if !self.held-fired { root.navigation-pressed(4); } }
                }
                Timer {
                    interval: 500ms;
                    running: center-touch.pressed && !center-touch.held-fired;
                    triggered => { center-touch.held-fired = true; root.knob2-pressed(); }
                }
            }
        }
        // Spring-return stick. Normalized axes remain available to the host.
        stick := Rectangle {
            visible: !root.panel-only;
            x: 44px; y: 280px; width: 104px; height: 104px;
            border-radius: 52px; background: #070809;
            border-width: 2px; border-color: #303438;
            property <bool> dragged: false;
            Rectangle {
                x: 9px; y: 9px; width: 86px; height: 86px;
                border-radius: 43px; background: #16191c; border-width: 1px; border-color: #202428;
            }
            Rectangle {
                x: 21px + root.stick-x * 18px; y: 21px + root.stick-y * 18px;
                width: 62px; height: 62px; border-radius: 31px;
                background: stick-touch.pressed ? #343a40 : #262b30;
                border-width: 2px; border-color: #4a5056;
                Rectangle {
                    x: 8px; y: 8px; width: 46px; height: 46px; border-radius: 23px;
                    border-width: 1px; border-color: #191c20;
                }
            }
            stick-touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { stick.dragged = false; }
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.stick-x = 0; root.stick-y = 0;
                    }
                }
                moved => {
                    if self.pressed {
                        if Math.abs(self.mouse-x - self.pressed-x) > 4px || Math.abs(self.mouse-y - self.pressed-y) > 4px { stick.dragged = true; }
                        root.stick-x = max(-1, min(1, (self.mouse-x - self.pressed-x) / 26px));
                        root.stick-y = max(-1, min(1, (self.mouse-y - self.pressed-y) / 26px));
                    }
                }
                clicked => { if !stick.dragged { root.stick-clicks += 1; if !root.stick-owned { root.navigation-pressed(4); } } }
            }
        }
        // Right-hand performance deck: same row-major pad IDs and gate edges.
        Rectangle {
            visible: !root.panel-only;
            x: 1022px; y: (parent.height - self.height) / 2; width: 376px; height: 376px;
            border-radius: 18px; background: #090a0b;
            border-width: 1px; border-color: #292c2f;
        }
        VerticalLayout {
            visible: !root.panel-only;
            x: 1030px; y: (parent.height - self.height) / 2; width: 360px; height: 360px;
            spacing: 4px;
            for row in [0, 1, 2, 3] : HorizontalLayout {
                spacing: 4px;
                for col in [0, 1, 2, 3] : Rectangle {
                    property <int> i: row * 4 + col;
                    property <bool> lit: root.pad-colors[i] != #232323 && root.pad-colors[i] != #000000 && root.pad-colors[i] != transparent;
                    property <color> light: pad-touch.pressed ? root.accent : root.pad-colors[i];
                    border-radius: 5px;
                    background: pad-touch.pressed || self.lit ? self.light : #b8bdb4;
                    border-width: 2px;
                    border-color: pad-touch.pressed || self.lit ? self.light : #aeb4a9;
                    // Broad matte silicone face, shallow bevel and softly rounded corners.
                    Rectangle {
                        x: 2px; y: pad-touch.pressed ? 3px : 1px;
                        width: parent.width - 4px; height: parent.height - 5px;
                        border-radius: 4px;
                        background: pad-touch.pressed || parent.lit ? parent.light : #f0f2eb;
                        border-width: 1px; border-color: #ffffff99;
                    }
                    Rectangle {
                        x: 10px; y: 4px; width: parent.width - 20px; height: 1px;
                        background: #ffffffbb;
                    }
                    // Full-face illumination follows the same live LED color as the rim.
                    Rectangle {
                        x: 9px; y: parent.height - 6px; width: parent.width - 18px; height: 2px;
                        border-radius: 1px;
                        background: pad-touch.pressed || parent.lit ? parent.light : #c0c6bb;
                    }
                    Text {
                        x: 7px; y: parent.height - 19px; width: parent.width - 14px; height: 12px;
                        text: i + 1; color: pad-touch.pressed || parent.lit ? #101113 : #92998c;
                        horizontal-alignment: right;
                        font-family: "JetBrains Mono"; font-size: 12px;
                    }
                    pad-touch := TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down { root.pad-pressed(i, true); }
                            else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.pad-pressed(i, false); }
                        }
                    }
                }
            }
        }
        // Rounded speaker slots form SZYK, with gaps between adjacent cuts.
        for slot in [
            { x: 0, y: 1, rows: 2 },
            { x: 0, y: 6, rows: 1 },
            { x: 1, y: 0, rows: 4 },
            { x: 1, y: 6, rows: 1 },
            { x: 2, y: 0, rows: 1 },
            { x: 2, y: 3, rows: 1 },
            { x: 2, y: 6, rows: 1 },
            { x: 3, y: 0, rows: 1 },
            { x: 3, y: 3, rows: 1 },
            { x: 3, y: 6, rows: 1 },
            { x: 4, y: 0, rows: 1 },
            { x: 4, y: 3, rows: 1 },
            { x: 4, y: 6, rows: 1 },
            { x: 5, y: 0, rows: 1 },
            { x: 5, y: 3, rows: 4 },
            { x: 6, y: 4, rows: 2 },
            { x: 9, y: 0, rows: 1 },
            { x: 9, y: 6, rows: 1 },
            { x: 10, y: 0, rows: 1 },
            { x: 10, y: 5, rows: 2 },
            { x: 11, y: 0, rows: 1 },
            { x: 11, y: 4, rows: 3 },
            { x: 12, y: 0, rows: 1 },
            { x: 12, y: 3, rows: 2 },
            { x: 12, y: 6, rows: 1 },
            { x: 13, y: 0, rows: 1 },
            { x: 13, y: 2, rows: 2 },
            { x: 13, y: 6, rows: 1 },
            { x: 14, y: 0, rows: 3 },
            { x: 14, y: 6, rows: 1 },
            { x: 15, y: 0, rows: 2 },
            { x: 15, y: 6, rows: 1 },
            { x: 18, y: 0, rows: 2 },
            { x: 19, y: 0, rows: 3 },
            { x: 20, y: 2, rows: 2 },
            { x: 21, y: 3, rows: 4 },
            { x: 22, y: 2, rows: 2 },
            { x: 23, y: 0, rows: 3 },
            { x: 24, y: 0, rows: 2 },
            { x: 27, y: 0, rows: 7 },
            { x: 28, y: 0, rows: 7 },
            { x: 29, y: 3, rows: 1 },
            { x: 30, y: 2, rows: 3 },
            { x: 31, y: 1, rows: 2 },
            { x: 31, y: 4, rows: 2 },
            { x: 32, y: 0, rows: 2 },
            { x: 32, y: 5, rows: 2 },
            { x: 33, y: 0, rows: 1 },
            { x: 33, y: 6, rows: 1 }
        ] : Rectangle {
            visible: !root.panel-only;
            x: 1075px + slot.x * 8px; y: 482px + slot.y * 8px;
            width: 4.5px; height: max(9px, slot.rows * 8px - 2px); border-radius: 2.25px;
            background: #030405; border-width: 1px; border-color: #303438;
        }
    }
}
