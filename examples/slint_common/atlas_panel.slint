// Atlas's right-hand panel: the preset's name and category, the seven
// performance macros as bars in two columns (unused slots dimmed), the
// MORPH track with its stored states A..D, and the live output -- spectrum
// or scope, whichever the preset asks for -- with the voice count and CPU
// load. See `AtlasExtra`. Sized to fit the 280px content area at the
// device's minimum type size (12px, docs/ACCESSIBILITY.md): nothing may
// reach the F-button bar.
import { InstrumentPanel, InstrumentLabel, ScopeSurface, SignalTrace } from "instrument_widgets.slint";

component MacroBar inherits HorizontalLayout {
    in property <string> name;
    in property <float> value;
    in property <bool> used;
    in property <color> ink;
    in property <color> accent;
    height: 15px;
    spacing: 4px;
    InstrumentLabel {
        text: root.name;
        ink: root.used ? root.ink : root.ink.with-alpha(0.4);
        font-size: 12px;
        width: 80px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        horizontal-stretch: 1;
        Rectangle { y: (parent.height - 6px) / 2; height: 6px; background: root.ink.with-alpha(0.1); border-radius: 3px; }
        if root.used : Rectangle {
            x: 0; y: (parent.height - 6px) / 2;
            height: 6px;
            width: parent.width * max(0, min(1, root.value));
            background: root.accent;
            border-radius: 3px;
        }
    }
}

export component AtlasPanel inherits InstrumentPanel {
    in property <string> name;
    in property <string> category;
    in property <string> description;
    in property <string> index;
    in property <[string]> macro-names;
    in property <[float]> macro-values;
    in property <[bool]> macro-used;
    in property <float> morph;
    in property <int> states: 1;
    in property <string> morph-label;
    in property <bool> spectrum-view: true;
    in property <[float]> spectrum;
    in property <[float]> scope-mid-x;
    in property <[float]> scope-mid-y;
    in property <[float]> scope-length;
    in property <[float]> scope-angle;
    in property <string> voices;
    in property <float> load;
    in property <string> depth;
    in property <string> status;

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            height: 20px;
            Text {
                text: root.name;
                color: root.ink;
                font-family: "Space Grotesk";
                font-size: 16px;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            InstrumentLabel { text: root.category + " " + root.index; ink: root.accent; font-size: 12px; width: 110px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        }

        // the seven macros, two columns
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                spacing: 2px;
                for i in [0, 2, 4, 6] : MacroBar {
                    name: i < root.macro-names.length ? root.macro-names[i] : "";
                    value: i < root.macro-values.length ? root.macro-values[i] : 0;
                    used: i < root.macro-used.length && root.macro-used[i];
                    ink: root.ink; accent: root.accent;
                }
            }
            VerticalLayout {
                spacing: 2px;
                for i in [1, 3, 5] : MacroBar {
                    name: i < root.macro-names.length ? root.macro-names[i] : "";
                    value: i < root.macro-values.length ? root.macro-values[i] : 0;
                    used: i < root.macro-used.length && root.macro-used[i];
                    ink: root.ink; accent: root.accent;
                }
                Rectangle { height: 15px; }
            }
        }

        // MORPH: the states sit evenly along the track
        HorizontalLayout {
            height: 15px;
            InstrumentLabel { text: "MORPH"; ink: root.ink; font-size: 12px; width: 66px; vertical-alignment: center; }
            InstrumentLabel { text: root.morph-label; ink: root.accent; font-size: 12px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
        }
        Rectangle {
            height: 16px;
            Rectangle { y: 7px; height: 2px; background: root.ink.with-alpha(0.2); }
            for s in root.states : Rectangle {
                x: root.states <= 1 ? 0 : (parent.width - 16px) * s / (root.states - 1);
                width: 16px; height: 16px;
                border-radius: 8px;
                background: root.ink.with-alpha(0.12);
                border-width: 1px;
                border-color: root.ink.with-alpha(0.5);
                Text { text: ["A", "B", "C", "D"][s]; color: root.ink; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                x: (parent.width - 6px) * max(0, min(1, root.morph));
                width: 6px; height: 16px;
                border-radius: 3px;
                background: root.accent;
            }
        }

        // live output
        ScopeSurface {
            height: 40px;
            ink: root.ink; accent: root.accent;
            if root.spectrum-view : Rectangle {
                for v[i] in root.spectrum : Rectangle {
                    x: parent.width * i / root.spectrum.length + 1px;
                    width: parent.width / root.spectrum.length - 2px;
                    y: parent.height * (1 - max(0, min(1, v)));
                    height: parent.height * max(0.01, min(1, v));
                    background: root.accent.with-alpha(0.85);
                }
            }
            if !root.spectrum-view : SignalTrace {
                width: 100%; height: 100%;
                mid-x: root.scope-mid-x; mid-y: root.scope-mid-y;
                lengths: root.scope-length; angles: root.scope-angle;
                source-width: 290; source-height: 40;
                trace: root.accent;
                stroke-width: 1.6px;
            }
        }
        HorizontalLayout {
            height: 15px;
            InstrumentLabel { text: root.status != "" ? root.status : root.voices; ink: root.ink.with-alpha(0.8); font-size: 12px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
            InstrumentLabel { text: "cpu " + Math.round(root.load * 100) + "%"; ink: root.ink.with-alpha(0.8); font-size: 12px; horizontal-alignment: right; width: 64px; vertical-alignment: center; }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
