component Button inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 21px; background: root.active ? #51351e : #211b18;
    border-width: 1px; border-color: #665b49;
    Text { text: root.label; color: #e8dcc3; font-family: "JetBrains Mono"; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

component Dial inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> norm;
    in property <bool> selected;
    callback edit(int);
    background: transparent;
    Text { y: 0px; height: 18px; width: 100%; text: root.value; color: #e7aa5e; font-family: "JetBrains Mono"; font-size: 11px; horizontal-alignment: center; overflow: elide; }
    Rectangle {
        x: (parent.width - 64px)/2; y: 23px; width: 64px; height: 64px;
        border-radius: 32px; background: root.selected ? #362a20 : #151413;
        border-width: 1px; border-color: root.selected ? #edb16a : #796a4e;
        Rectangle { x: 6px; y: 6px; width: 52px; height: 52px; border-radius: 26px; border-width: 1px; border-color: #a48d64; background: #232120; }
        Path {
            width: 64px; height: 64px; viewbox-width: 64; viewbox-height: 64;
            stroke: #eee0bc; stroke-width: 2px;
            MoveTo { x: 32; y: 32; }
            LineTo { x: 32 + 24*sin((-135 + 270*max(0,root.norm))*1deg); y: 32 - 24*cos((-135 + 270*max(0,root.norm))*1deg); }
        }
        TouchArea {
            property <length> last-y;
            pointer-event(e) => { if e.kind == PointerEventKind.down { self.last-y = self.mouse-y; root.edit(0); } }
            moved => { if self.pressed { if self.last-y - self.mouse-y >= 3px { root.edit(1); self.last-y = self.mouse-y; } else if self.mouse-y - self.last-y >= 3px { root.edit(-1); self.last-y = self.mouse-y; } } }
        }
    }
    Text { y: 92px; height: 18px; width: 100%; text: root.label; color: #e8dcc3; font-family: "JetBrains Mono"; font-size: 10px; horizontal-alignment: center; overflow: elide; }
    Button { x: 15px; y: 48px; width: 21px; label: "−"; clicked => { root.edit(-1); } }
    Button { x: parent.width - 36px; y: 48px; width: 21px; label: "+"; clicked => { root.edit(1); } }
}

export component Rev2Panel inherits Rectangle {
    in property <string> program;
    in property <string> source;
    in property <string> status;
    in property <[string]> sections;
    in property <int> section;
    in property <int> layer;
    in property <int> page;
    in property <int> pages;
    in property <int> sequence-page;
    in property <int> velocity-track;
    in property <int> selected;
    in property <[string]> labels;
    in property <[string]> values;
    in property <[float]> norms;
    in property <[bool]> keys;
    in property <bool> dirty;
    in property <bool> comparing;
    in property <float> peak;
    callback action(float, float);
    background: #100e10;
    for side in [0,1] : Rectangle {
        x: side == 0 ? 0px : parent.width - 18px; width: 18px; height: 100%; background: #663923;
        for stripe in [1,4,7,10,13,16] : Rectangle { x: stripe*1px; width: 1px; height: 100%; background: #a86e3c; opacity: 0.4; }
    }
    Text { x: 26px; y: 4px; text: "SZYK"; color: #8f8572; font-size: 9px; font-family: "JetBrains Mono"; }
    Text { x: 26px; y: 17px; text: "REV2"; color: #eee3cc; font-size: 28px; font-family: "Space Grotesk"; }
    Text { x: 123px; y: 11px; text: root.program + (root.dirty ? " *" : ""); color: #e8c396; font-size: 14px; font-family: "JetBrains Mono"; }
    Text { x: 123px; y: 32px; width: 340px; text: root.source; color: #8f8572; font-size: 9px; font-family: "JetBrains Mono"; overflow: elide; }
    Rectangle { x: parent.width - 108px; y: 9px; width: 75px; height: 22px; background: #230807;
        Text { text: root.layer == 0 ? "LAYER A" : "LAYER B"; color: #ff542b; font-size: 12px; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.action(1205,0); } }
    }
    Rectangle { x: parent.width - 108px; y: 36px; width: 75px; height: 4px; background: #362018;
        Rectangle { width: parent.width*min(1,root.peak); height: 100%; background: #e95d30; }
    }
    Rectangle { x: 26px; y: 52px; width: parent.width - 52px; height: 1px; background: #7a6a51; }
    HorizontalLayout {
        x: 26px; y: 60px; width: parent.width - 52px; height: 21px; spacing: 5px;
        Button { width: 25px; label: "‹"; clicked => { root.action(1200,-1); } }
        Button { width: 25px; label: "›"; clicked => { root.action(1200,1); } }
        Button { label: "PATCHES"; active: root.section == 14; clicked => { root.action(1201,0); } }
        Button { label: "COMPARE"; active: root.comparing; clicked => { root.action(1202,0); } }
        Button { label: "INIT"; clicked => { root.action(1203,0); } }
        Button { label: "SAVE"; clicked => { root.action(1204,0); } }
        Button { label: "PERFORM"; active: root.section == 15; clicked => { root.action(1206,0); } }
    }
    for label[i] in ["OSC","FILTER / AMP","ENVELOPES","LFO","MOD MATRIX","CONTROLLERS","FX","VOICE / CLOCK","ARP","GATED SEQ","NOTES 1–2","NOTES 3–4","NOTES 5–6","VELOCITIES","PROGRAMS","PERFORMANCE"] : Button {
        x: 26px+mod(i,8)*(root.width - 52px)/8; y: 91px+floor(i/8)*22px; width: (root.width - 52px)/8-3px; height: 19px;
        label: label; active: i == root.section; clicked => { root.action(1000+i,0); }
    }
    for label[i] in root.labels : Dial {
        x: 26px+i*(root.width - 52px)/4; y: 148px; width: (root.width - 52px)/4; height: 112px;
        label: label; value: root.values[i]; norm: root.norms[i]; selected: root.selected == i;
        edit(delta) => { root.action(1100+i,delta); }
    }
    Rectangle { x: 26px; y: 265px; width: parent.width - 52px; height: 1px; background: #7a6a51; }
    Text { x: 26px; y: 272px; width: parent.width - (root.section >= 10 && root.section <= 13 ? 375px : 175px); text: root.labels[root.selected] + " / " + root.values[root.selected]; color: #edc78e; font-size: 10px; font-family: "JetBrains Mono"; overflow: elide; }
    if root.section >= 10 && root.section <= 13 : Button {
        x: parent.width - 342px; y: 270px; width: 83px;
        label: "STEP " + (root.sequence-page*16+1) + "–" + (root.sequence-page*16+16);
        clicked => { root.action(1207,0); }
    }
    if root.section == 13 : Button {
        x: parent.width - 254px; y: 270px; width: 100px;
        label: "VEL TRACK " + (root.velocity-track+1);
        clicked => { root.action(1208,0); }
    }
    Button { x: parent.width - 140px; y: 270px; width: 22px; label: "‹"; clicked => { root.action(1400,-1); } }
    Text { x: parent.width - 114px; y: 274px; text: (root.page+1)+" / "+root.pages; color: #a69a86; font-size: 10px; font-family: "JetBrains Mono"; }
    Button { x: parent.width - 52px; y: 270px; width: 22px; label: "›"; clicked => { root.action(1400,1); } }
    for note[i] in [0,2,4,5,7,9,11,12,14,16,17,19,21,23] : Rectangle {
        x: 26px+i*(root.width - 52px)/14; y: 298px; width: (root.width - 52px)/14-1px; height: 37px;
        background: root.keys[note] ? #dcab5d : #eee0bc;
        TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.action(1300+note,1); } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.action(1300+note,0); } } }
    }
    for note[i] in [1,3,6,8,10,13,15,18,20,22] : Rectangle {
        x: 26px+([1,2,4,5,6,8,9,11,12,13][i])*(root.width - 52px)/14-9px; y: 298px; width: 18px; height: 23px;
        background: root.keys[note] ? #b47638 : #171414;
        TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down { root.action(1300+note,1); } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.action(1300+note,0); } } }
    }
    Text { x: 26px; y: 341px; width: parent.width - 52px; text: root.status; color: #8f8572; font-size: 9px; font-family: "JetBrains Mono"; overflow: elide; }
}
